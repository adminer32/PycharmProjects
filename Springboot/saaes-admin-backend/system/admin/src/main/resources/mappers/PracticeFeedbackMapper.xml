<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.saaes.system.admin.practice.mapper.PracticeFeedbackMapper">

    <!-- 物理删除过期的逻辑删除数据 -->
    <delete id="deleteHardExpired">
        DELETE FROM practice_feedback
        WHERE deleted = 1
        AND IFNULL(update_time, create_time) &lt; #{threshold}
    </delete>

</mapper>
